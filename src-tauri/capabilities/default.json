{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-environment",
    "allow-refresh-environment",
    "allow-get-settings",
    "allow-update-settings",
    "allow-test-proxy",
    "allow-list-tools",
    "allow-refresh-tools"
  ]
}
